---
const navItems = [
  { label: '글 Writing', href: '/writing' },
  { label: '도구 Tools', href: '/tools' },
  { label: '함께하는 팀 Companies', href: '/companies' },
  { label: '소개 About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header class="w-full border-b border-ink/12">
  <nav class="max-w-3xl mx-auto px-6 py-5 flex items-center justify-between gap-8">
    <a href="/" class="font-serif text-xl font-bold text-ink hover:text-ink/70 shrink-0">
      YoongJae
    </a>
    <div class="flex items-center gap-5 md:gap-6">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-xs md:text-sm font-bold transition-colors',
            currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
              ? 'text-ink'
              : 'text-ink/55 hover:text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
