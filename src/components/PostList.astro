---
import { formatDate } from '../lib/posts';
import type { Post } from '../lib/types';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="space-y-0 divide-y divide-ink/5">
  {posts.map((post) => (
    <li>
      <a
        href={post.url}
        target={post.isExternal ? '_blank' : undefined}
        rel={post.isExternal ? 'noopener noreferrer' : undefined}
        class="group flex items-start gap-4 py-4 hover:bg-ink/[0.02] -mx-3 px-3 rounded-lg transition-colors"
      >
        <time class="text-sm text-ink/40 font-mono shrink-0 pt-0.5" datetime={post.date.toISOString()}>
          {formatDate(post.date)}
        </time>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            {post.isPaid && (
              <span class="text-accent-orange text-sm shrink-0" title="Paid content">
                &#x1f512;
              </span>
            )}
            <span class="text-ink group-hover:text-accent-blue transition-colors font-medium truncate">
              {post.title}
            </span>
            {post.substackUrl && !post.isExternal && (
              <span class="text-[10px] text-accent-orange bg-accent-orange/10 px-1.5 py-0.5 rounded shrink-0">
                Substack
              </span>
            )}
            {post.isExternal && (
              <svg
                class="w-3.5 h-3.5 text-ink/30 shrink-0"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            )}
          </div>
          {post.description && (
            <p class="text-sm text-ink/50 mt-1 line-clamp-1">{post.description}</p>
          )}
        </div>
        <div class="flex gap-1.5 shrink-0 pt-1">
          {post.tags.map((tag) => (
            <span class="text-xs text-ink/30 bg-ink/[0.03] px-2 py-0.5 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      </a>
    </li>
  ))}
</ul>

{posts.length === 0 && (
  <p class="text-center text-ink/40 py-12">No posts yet.</p>
)}
