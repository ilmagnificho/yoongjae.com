---
import { formatDate } from '../lib/posts';
import type { Post } from '../lib/types';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="divide-y divide-ink/8">
  {posts.map((post) => (
    <li>
      <a
        href={post.url}
        target={post.isExternal ? '_blank' : undefined}
        rel={post.isExternal ? 'noopener noreferrer' : undefined}
        class="group flex items-baseline gap-3 py-2.5 hover:bg-ink/[0.02] -mx-2 px-2 rounded transition-colors"
      >
        <time class="text-xs text-ink/45 font-mono shrink-0" datetime={post.date.toISOString()}>
          {formatDate(post.date)}
        </time>
        <div class="flex-1 min-w-0 flex items-baseline gap-2">
          {post.isPaid && (
            <span class="text-accent-orange text-xs shrink-0" title="Paid content">&#x1f512;</span>
          )}
          <span class="text-sm text-ink group-hover:text-accent-blue transition-colors font-medium truncate">
            {post.title}
          </span>
          {post.substackUrl && !post.isExternal && (
            <span class="text-[9px] text-accent-orange bg-accent-orange/10 px-1 py-px rounded shrink-0 hidden sm:inline">
              Substack
            </span>
          )}
          {post.isExternal && (
            <svg class="w-3 h-3 text-ink/35 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          )}
        </div>
        <div class="hidden sm:flex gap-1 shrink-0">
          {post.tags.map((tag) => (
            <span class="text-[10px] text-ink/35 bg-ink/[0.05] px-1.5 py-px rounded-full">
              {tag}
            </span>
          ))}
        </div>
      </a>
    </li>
  ))}
</ul>

{posts.length === 0 && (
  <p class="text-center text-ink/40 py-8 text-sm">No posts yet.</p>
)}
