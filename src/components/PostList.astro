---
import { formatDate } from '../lib/posts';
import type { Post } from '../lib/types';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<ul class="divide-y divide-ink/8">
  {posts.map((post) => (
    <li>
      <a
        href={post.url}
        class="group flex items-baseline gap-3 py-2.5 hover:bg-ink/[0.02] -mx-2 px-2 rounded transition-colors"
      >
        <time class="text-xs text-ink/45 font-mono shrink-0" datetime={post.date.toISOString()}>
          {formatDate(post.date)}
        </time>
        <div class="flex-1 min-w-0 flex items-baseline gap-2">
          <span class="text-sm text-ink group-hover:text-accent-blue transition-colors font-bold truncate">
            {post.title}
          </span>
        </div>
        <div class="hidden sm:flex gap-1 shrink-0">
          {post.tags.map((tag) => (
            <span class="text-[10px] text-ink/35 bg-ink/[0.05] px-1.5 py-px rounded-full">
              {tag}
            </span>
          ))}
        </div>
      </a>
    </li>
  ))}
</ul>
{posts.length === 0 && (
  <p class="text-center text-ink/40 py-8 text-sm">{t('postList.empty')}</p>
)}
