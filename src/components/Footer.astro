---
const socialLinks = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/yjcho/' },
  { label: 'Threads', href: 'https://www.threads.com/@ilmagnificho' },
];

const year = new Date().getFullYear();
---

<footer class="w-full border-t border-ink/10 mt-auto">
  <div class="max-w-3xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
      <!-- Newsletter -->
      <div class="flex-1">
        <h3 class="font-serif text-lg font-semibold mb-2">Newsletter</h3>
        <p class="text-sm text-ink/60 mb-4">
          Subscribe for insights on tech, venture, and startups.
        </p>
        <a
          href="https://yoongjae.substack.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-orange text-white text-sm font-medium rounded-lg hover:bg-accent-orange/90 transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
          </svg>
          Subscribe on Substack
        </a>
      </div>

      <!-- Social Links -->
      <div class="flex flex-col items-start md:items-end gap-2">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-ink/50 hover:text-ink transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-ink/5 text-center">
      <p class="text-xs text-ink/40">&copy; {year} YoongJae. All rights reserved.</p>
    </div>
  </div>
</footer>
