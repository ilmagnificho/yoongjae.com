---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const socialLinks = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/yjcho/' },
  { label: 'Threads', href: 'https://www.threads.com/@ilmagnificho' },
];

const year = new Date().getFullYear();
---

<footer class="w-full border-t border-ink/12 mt-auto">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
      <!-- Newsletter (Stibee) -->
      <div class="flex-1 max-w-sm">
        <h3 class="font-serif text-base font-semibold mb-1">{t('footer.newsletter.title')}</h3>
        <p class="text-xs text-ink/65 mb-3">
          {t('footer.newsletter.description')}
        </p>
        <form
          action="https://stibee.com/api/v1.0/lists/FPtktD6uOmYxjdvwSIaGCPwM3px-iA==/public/subscribers"
          method="POST"
          target="_blank"
          class="space-y-2"
        >
          <input
            type="email"
            name="email"
            required
            placeholder={t('footer.email.placeholder')}
            class="w-full bg-transparent border border-ink/15 rounded-lg px-3 py-1.5 text-xs placeholder:text-ink/30 focus:outline-none focus:border-ink/40"
          />
          <div class="flex gap-2">
            <input
              type="text"
              name="name"
              required
              placeholder={t('footer.name.placeholder')}
              class="flex-1 bg-transparent border border-ink/15 rounded-lg px-3 py-1.5 text-xs placeholder:text-ink/30 focus:outline-none focus:border-ink/40"
            />
            <input
              type="text"
              name="phone_number"
              placeholder={t('footer.phone.placeholder')}
              class="flex-1 bg-transparent border border-ink/15 rounded-lg px-3 py-1.5 text-xs placeholder:text-ink/30 focus:outline-none focus:border-ink/40"
            />
          </div>
          <label class="flex items-start gap-1.5 cursor-pointer">
            <input type="checkbox" name="agree_privacy" required class="mt-0.5 accent-ink" />
            <span class="text-[10px] text-ink/40 leading-tight">{t('footer.privacy')}</span>
          </label>
          <button
            type="submit"
            class="w-full px-4 py-2 bg-ink text-paper text-xs font-medium rounded-lg hover:bg-ink/80 transition-colors"
          >
            {t('footer.subscribe')}
          </button>
        </form>
      </div>

      <!-- Social Links -->
      <div class="flex flex-col items-start md:items-end gap-2">
        <a
          href="/bts"
          class="text-sm font-semibold text-[#6A0DAD] hover:text-[#4A0080] transition-colors"
        >
          BTS 광화문 가이드 →
        </a>
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-ink/55 hover:text-ink transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-ink/8 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-xs text-ink/50">&copy; {year} YoongJae. All rights reserved.</p>
      <a href="/privacy" class="text-xs text-ink/35 hover:text-ink/60 transition-colors">개인정보 처리방침</a>
    </div>
  </div>
</footer>
