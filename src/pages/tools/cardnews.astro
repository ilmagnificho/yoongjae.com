---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CardNewsEditor } from '../../components/tools/cardnews';

const title = 'CardNews Studio - AI 카드뉴스 생성기';
const description = '카드뉴스를 직접 디자인하고 편집하세요. 폰트 크기, 줄바꿈, 배경 이미지를 자유롭게 조절할 수 있습니다.';

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'CardNews Studio',
  url: 'https://yoongjae.com/tools/cardnews/',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  author: { '@type': 'Person', name: '조융재', url: 'https://yoongjae.com' },
};
---

<BaseLayout title={title} description={description} canonicalUrl="/tools/cardnews/" hideFooter>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet" />
    <style>
      body { margin: 0; overflow: hidden; }
      .cardnews-container { width: 100%; height: 100dvh; }
    </style>
  </Fragment>

  <div class="cardnews-container">
    <CardNewsEditor client:only="react" />
  </div>
</BaseLayout>
