---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '투자 못 받는 시뮬레이터 - 극악 난이도 창업 RPG';
const description = '갖은 이유와 예상치 못한 상황이 자꾸 발생해서 투자를 못 받는 창업자 시뮬레이터. 클리어율 3.4%의 극악 난이도를 뚫어보세요!';

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '투자 못 받는 시뮬레이터',
  url: 'https://yoongjae.com/tools/vc-simulator/',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  author: { '@type': 'Person', name: '조융재', url: 'https://yoongjae.com' },
};
---

<BaseLayout title={title} description={description} canonicalUrl="/tools/vc-simulator" ogImage="/vc-simulator/og-image.png">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <style>
      .vc-sim-wrap { margin: 0 -1rem; }
      @media (min-width: 640px) { .vc-sim-wrap { margin: 0 -2rem; } }
      .vc-sim-frame {
        width: 100%;
        height: 100dvh;
        max-height: calc(100dvh - 60px);
        min-height: 600px;
        border: none;
        border-radius: 8px;
        background: #1a1a2e;
      }
    </style>
  </Fragment>

  <section class="py-4">
    <div class="flex items-center gap-2 text-xs text-ink/40 mb-4">
      <a href="/tools/" class="hover:text-ink transition-colors">Tools</a>
      <span>/</span>
      <span>투자 못 받는 시뮬레이터</span>
    </div>

    <div class="vc-sim-wrap">
      <iframe
        src="/vc-simulator/index.html"
        class="vc-sim-frame"
        title="투자 못 받는 시뮬레이터"
        loading="lazy"
      ></iframe>
    </div>
  </section>
</BaseLayout>
