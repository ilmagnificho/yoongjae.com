---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = Astro.site?.toString() ?? 'https://yoongjae.com';

const tools = [
  {
    name: 'PromptForge',
    description: 'Claude Projects & Gemini Gems용 시스템 프롬프트 생성기. 13개 전문 템플릿, 완전 무료.',
    href: '/tools/prompt',
    badge: 'Free',
  },
  {
    name: 'Cap Table 계산기',
    description: '투자 라운드별 지분 희석을 시뮬레이션하세요',
    href: '/tools/cap-table',
  },
  {
    name: 'SAFE & Convertible Note 시뮬레이터',
    description: 'Valuation Cap과 Discount에 따른 전환 주식 수와 지분율 계산',
    href: '/tools/safe-simulator',
  },
  {
    name: 'ESOP (스톡옵션) 가치 계산기',
    description: 'Exit 시나리오별 스톡옵션의 잠재 수익을 시뮬레이션하세요',
    href: '/tools/esop-calculator',
  },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Tools by YJ Cho',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(tool.href, siteUrl).toString(),
    name: tool.name,
    description: tool.description,
  })),
};
---

<BaseLayout
  title="Tools — YJ Cho"
  description="Claude 프롬프트 생성기, 스타트업 금융 계산기 등 창업자와 개발자를 위한 무료 도구 모음입니다."
  canonicalUrl="/tools"
  ogImage="/og/tools.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <section class="py-4">
    <h1 class="font-serif text-3xl font-bold mb-2">Tools</h1>
    <p class="text-sm text-ink/55 mb-8">창업자와 개발자를 위한 무료 도구 모음</p>

    <div class="grid gap-4">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="group block border border-ink/10 rounded-lg p-5 hover:border-ink/20 hover:bg-ink/[0.02] transition-all"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <h2 class="font-serif text-lg font-semibold group-hover:text-accent-blue transition-colors">
                  {tool.name}
                </h2>
                {tool.badge && (
                  <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-green-100 text-green-700">
                    {tool.badge}
                  </span>
                )}
              </div>
              <p class="text-sm text-ink/55">{tool.description}</p>
            </div>
          </div>
          <span class="text-sm text-accent-blue mt-3 inline-block group-hover:translate-x-0.5 transition-transform">
            사용하기 &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
