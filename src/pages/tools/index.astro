---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = Astro.site?.toString() ?? 'https://yoongjae.com';

const tools = [
  {
    name: 'Cap Table 계산기',
    description: '투자 라운드별 지분 희석을 시뮬레이션하세요',
    href: '/tools/cap-table',
    available: true,
  },
  {
    name: 'Runway 계산기',
    description: '현재 번레이트와 잔액으로 런웨이를 계산하세요',
    href: '/tools/runway',
    available: false,
  },
  {
    name: '지분 희석 시뮬레이터',
    description: '여러 라운드에 걸친 창업자 지분 변화를 시각화하세요',
    href: '/tools/dilution',
    available: false,
  },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Startup Finance Tools',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(tool.href, siteUrl).toString(),
    name: tool.name,
    description: tool.description,
  })),
};
---

<BaseLayout
  title="스타트업 창업자를 위한 무료 금융 계산 도구"
  description="Cap Table 계산기, Runway 계산기 등 스타트업 창업자와 투자자를 위한 무료 계산 도구 모음입니다."
  canonicalUrl="/tools"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <section class="py-4">
    <h1 class="font-serif text-3xl font-bold mb-2">Tools</h1>
    <p class="text-sm text-ink/55 mb-8">스타트업 창업자와 투자자를 위한 무료 계산 도구</p>

    <div class="grid gap-4">
      {tools.map((tool) => (
        tool.available ? (
          <a
            href={tool.href}
            class="group block border border-ink/10 rounded-lg p-5 hover:border-ink/20 hover:bg-ink/[0.02] transition-all"
          >
            <div class="flex items-start justify-between gap-3">
              <div>
                <h2 class="font-serif text-lg font-semibold group-hover:text-accent-blue transition-colors">
                  {tool.name}
                </h2>
                <p class="text-sm text-ink/55 mt-1">{tool.description}</p>
              </div>
              <span class="text-[10px] text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full shrink-0 font-medium mt-1">
                사용 가능
              </span>
            </div>
            <span class="text-sm text-accent-blue mt-3 inline-block group-hover:translate-x-0.5 transition-transform">
              사용하기 &rarr;
            </span>
          </a>
        ) : (
          <div class="border border-ink/8 rounded-lg p-5 opacity-60">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h2 class="font-serif text-lg font-semibold">{tool.name}</h2>
                <p class="text-sm text-ink/45 mt-1">{tool.description}</p>
              </div>
              <span class="text-[10px] text-ink/40 bg-ink/[0.05] px-2 py-0.5 rounded-full shrink-0 font-medium mt-1">
                준비 중
              </span>
            </div>
          </div>
        )
      ))}
    </div>
  </section>
</BaseLayout>
