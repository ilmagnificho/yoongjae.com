---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptForge from '../../components/tools/PromptForge';

const title = 'PromptForge — Claude & Gemini 시스템 프롬프트 생성기';
const description = 'Claude Projects와 Gemini Gems를 위한 전문가급 시스템 프롬프트를 몇 초 만에 생성하세요. 13개 템플릿, 무료, 설치 불필요.';

const faqs = [
  {
    q: 'PromptForge가 뭔가요?',
    a: 'Claude Projects나 Gemini Gems를 만들 때 "Custom Instructions(지침)" 필드에 넣을 시스템 프롬프트를 자동으로 생성해주는 웹 도구입니다. 프롬프트 엔지니어링 지식 없이도 전문가급 설정을 몇 초 만에 완성할 수 있습니다.',
  },
  {
    q: 'Claude Projects 포맷과 Gemini Gems 포맷이 다른가요?',
    a: '네. Claude Projects는 XML 태그 구조(<role>, <guidelines>, <output_format>)를 활용한 상세한 프롬프트를, Gemini Gems는 간결하고 직관적인 평문 형식을 사용합니다. PromptForge는 선택한 플랫폼에 최적화된 형식으로 자동 생성합니다.',
  },
  {
    q: '생성된 프롬프트는 어떻게 사용하나요?',
    a: 'Claude: claude.ai → Projects → 프로젝트 생성 또는 열기 → Project Instructions → 붙여넣기. Gemini: gemini.google.com → Gems → Create a Gem → Instructions 필드 → 붙여넣기.',
  },
  {
    q: '데이터는 어디에 저장되나요?',
    a: '모든 프롬프트 생성은 브라우저 내에서만 처리됩니다. 서버로 전송되는 데이터가 없으며, API 호출도 없습니다. 완전히 클라이언트 사이드에서 작동합니다.',
  },
  {
    q: '무료인가요?',
    a: '네, 완전 무료입니다. 설치도 필요 없고, 계정 가입도 없습니다. 바로 사용하세요.',
  },
];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'PromptForge',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Web',
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'YJ Cho', url: 'https://yoongjae.com' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<BaseLayout title={title} description={description} canonicalUrl="/tools/prompt" ogImage="/og/prompt.png">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumb + header -->
  <section class="py-4">
    <div class="flex items-center gap-2 text-xs text-ink/40 mb-4">
      <a href="/tools/" class="hover:text-ink transition-colors">Tools</a>
      <span>/</span>
      <span>PromptForge</span>
    </div>
    <h1 class="font-serif text-3xl font-bold mb-3">PromptForge</h1>
    <p class="text-sm text-ink/60 leading-relaxed max-w-2xl">
      Claude Projects와 Gemini Gems용 시스템 프롬프트를 몇 초 만에 생성합니다.
      13개 전문 템플릿, 완전 무료, 설치 불필요.
    </p>
  </section>

  <!-- Tool -->
  <section class="pb-10">
    <PromptForge client:load />
  </section>

  <!-- FAQ -->
  <section class="py-8 border-t border-ink/10">
    <h2 class="font-serif text-xl font-semibold mb-6">자주 묻는 질문</h2>
    <div class="space-y-5">
      {faqs.map((faq) => (
        <details class="group">
          <summary class="cursor-pointer text-sm font-medium text-ink hover:text-accent-blue transition-colors list-none flex items-start gap-2">
            <span class="text-ink/30 group-open:rotate-90 transition-transform mt-0.5">&#9654;</span>
            {faq.q}
          </summary>
          <p class="text-sm text-ink/60 leading-relaxed mt-2 ml-5">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
