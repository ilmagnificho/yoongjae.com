---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.isDraft)
    .map((post) => ({
      params: { id: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const postUrl = `/writing/${post.id}`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://yoongjae.com';

// Reading time (Korean ~500 chars/min)
const body = post.body ?? '';
const plainText = body.replace(/```[\s\S]*?```/g, '').replace(/[#*>\-\[\]()!`|_~]/g, '').replace(/https?:\/\/\S+/g, '').trim();
const readingTime = Math.max(1, Math.round(plainText.length / 500));

// Related posts (same tag, exclude self)
const allPosts = (await getCollection('blog')).filter((p) => !p.data.isDraft && p.id !== post.id);
const currentTags = post.data.tags ?? [];
const relatedPosts = allPosts
  .filter((p) => p.data.tags?.some((t: string) => currentTags.includes(t)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author ?? 'YoongJae Cho',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: 'YoongJae Cho',
    url: siteUrl,
  },
  ...(post.data.translator ? { translator: { '@type': 'Person', name: post.data.translator } } : {}),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(postUrl, siteUrl).toString(),
  },
  image: new URL(`/writing/${post.id}-og.png`, siteUrl).toString(),
  keywords: post.data.tags?.join(', '),
  inLanguage: 'ko',
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={`/writing/${post.id}-og.png`}
  ogType="article"
  articleDate={post.data.date}
  articleTags={post.data.tags}
  canonicalUrl={postUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  </Fragment>
  <article class="py-4">
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <time class="text-xs text-ink/40 font-mono" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <span class="text-[10px] text-ink/30">&middot;</span>
        <span class="text-xs text-ink/40">{readingTime}분 읽기</span>
        <div class="flex gap-1.5">
          {post.data.tags.map((tag: string) => (
            <span class="text-[10px] text-ink/40 bg-ink/[0.04] px-1.5 py-0.5 rounded-full">{tag}</span>
          ))}
        </div>
      </div>
      <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight">{post.data.title}</h1>
      {(post.data.author || post.data.translator) && (
        <p class="text-xs text-ink/40 mt-2">
          {post.data.author && <span>저자: {post.data.author}</span>}
          {post.data.author && post.data.translator && <span class="mx-1">·</span>}
          {post.data.translator && <span>번역: {post.data.translator}</span>}
        </p>
      )}
      {post.data.description && (
        <p class="text-base text-ink/50 mt-3">{post.data.description}</p>
      )}
    </header>

    <div class="prose text-ink/80 text-sm leading-relaxed">
      <Content />
    </div>

    <!-- Newsletter CTA -->
    <aside class="mt-10 border border-ink/10 rounded-lg p-5">
      <p class="text-sm font-bold text-ink mb-1">이런 글을 계속 받아보고 싶으시다면</p>
      <p class="text-xs text-ink/50 mb-3">투자·빌딩 인사이트를 메일로 전합니다.</p>
      <form
        action="https://stibee.com/api/v1.0/lists/FPtktD6uOmYxjdvwSIaGCPwM3px-iA==/public/subscribers"
        method="POST"
        target="_blank"
        class="space-y-2"
      >
        <div class="flex gap-2">
          <input
            type="email"
            name="email"
            required
            placeholder="이메일 주소"
            class="flex-1 bg-transparent border border-ink/15 rounded-lg px-3 py-1.5 text-xs placeholder:text-ink/30 focus:outline-none focus:border-ink/40"
          />
          <input
            type="text"
            name="name"
            required
            placeholder="이름"
            class="w-24 bg-transparent border border-ink/15 rounded-lg px-3 py-1.5 text-xs placeholder:text-ink/30 focus:outline-none focus:border-ink/40"
          />
          <button
            type="submit"
            class="px-4 py-1.5 bg-ink text-paper text-xs font-medium rounded-lg hover:bg-ink/80 transition-colors shrink-0"
          >
            구독
          </button>
        </div>
      </form>
    </aside>

    <ShareButtons title={post.data.title} url={postUrl} />

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="mt-8 pt-6 border-t border-ink/10">
        <h2 class="text-sm font-bold text-ink mb-3">관련 글</h2>
        <div class="space-y-2">
          {relatedPosts.map((related) => (
            <a
              href={`/writing/${related.id}/`}
              class="group flex items-baseline justify-between gap-4 py-1.5"
            >
              <span class="text-sm text-ink/70 group-hover:text-ink transition-colors line-clamp-1">
                {related.data.title}
              </span>
              <time class="text-[11px] text-ink/35 font-mono shrink-0">
                {formatDate(related.data.date)}
              </time>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="mt-6 pt-6 border-t border-ink/10">
      <a href="/writing/" class="text-xs text-ink/40 hover:text-ink transition-colors">
        &larr; 글 목록으로
      </a>
    </footer>
  </article>
</BaseLayout>
