---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const siteUrl = Astro.site?.toString() ?? 'https://yoongjae.com';

const tools = [
  {
    name: 'Fund Me If You Can',
    description: 'A satirical RPG based on Silicon Valley\'s most controversial AI startup. Play as the Founder or VC.',
    href: '/tools/fund-me',
    badge: 'New',
  },
  {
    name: 'CardNews Studio',
    description: 'Generate card news with AI. Enter a topic and get designed card news automatically. (OpenAI API key required)',
    href: '/tools/cardnews',
  },
  {
    name: 'VC Rejection Simulator',
    description: 'A brutally hard startup RPG with 3.4% clear rate. Experience the founder fundraising nightmare!',
    href: '/tools/vc-simulator',
  },
  {
    name: 'PromptForge',
    description: 'System prompt generator for Claude Projects & Gemini Gems. 13 expert templates, completely free.',
    href: '/tools/prompt',
    badge: 'Free',
  },
  {
    name: 'Cap Table Calculator',
    description: 'Simulate equity dilution across investment rounds',
    href: '/tools/cap-table',
  },
  {
    name: 'SAFE & Convertible Note Simulator',
    description: 'Calculate conversion shares and ownership based on Valuation Cap and Discount',
    href: '/tools/safe-simulator',
  },
  {
    name: 'ESOP (Stock Options) Value Calculator',
    description: 'Simulate stock option value across exit scenarios',
    href: '/tools/esop-calculator',
  },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Tools by YJ Cho',
  numberOfItems: tools.length,
  itemListElement: tools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(tool.href, siteUrl).toString(),
    name: tool.name,
    description: tool.description,
  })),
};
---

<BaseLayout
  title="Tools — YJ Cho"
  description="Free tools for founders and developers: prompt generators, cap table calculators, SAFE simulators, and more."
  canonicalUrl="/en/tools"
  ogImage="/og/tools.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <section class="py-4">
    <h1 class="font-serif text-3xl font-bold mb-2">Tools</h1>
    <p class="text-sm text-ink/55 mb-8">Free tools for founders and developers</p>

    <div class="grid gap-4">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="group block border border-ink/10 rounded-lg p-5 hover:border-ink/20 hover:bg-ink/[0.02] transition-all"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <h2 class="font-serif text-lg font-semibold group-hover:text-accent-blue transition-colors">
                  {tool.name}
                </h2>
                {tool.badge && (
                  <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-green-100 text-green-700">
                    {tool.badge}
                  </span>
                )}
              </div>
              <p class="text-sm text-ink/55">{tool.description}</p>
            </div>
          </div>
          <span class="text-sm text-accent-blue mt-3 inline-block group-hover:translate-x-0.5 transition-transform">
            Use Tool &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
