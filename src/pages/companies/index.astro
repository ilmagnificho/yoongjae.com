---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = Astro.site?.toString() ?? 'https://yoongjae.com';

const portfolioEntries = await getCollection('portfolio');
const sortedEntries = portfolioEntries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Companies',
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: sortedEntries.length,
  itemListElement: sortedEntries.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: entry.data.url ?? new URL(`/companies#${entry.id}`, siteUrl).toString(),
    name: entry.data.title,
    description: entry.data.description,
  })),
};
---

<BaseLayout title="함께하는 팀 Companies" description="조약돌개인투자조합이 함께하는 초기 스타트업을 소개합니다." canonicalUrl="/companies">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <section class="py-4">
    <h1 class="font-serif text-3xl font-bold mb-2">함께하는 팀</h1>
    <p class="text-sm text-ink/55 mb-8">조약돌개인투자조합이 초기부터 함께 만들어가고 있는 팀들입니다.</p>

    <div class="space-y-0 divide-y divide-ink/8">
      {sortedEntries.map((entry) => {
        const Tag = entry.data.url ? 'a' : 'div';
        const linkProps = entry.data.url
          ? { href: entry.data.url, target: '_blank', rel: 'noopener noreferrer' }
          : {};
        return (
          <Tag
            {...linkProps}
            class:list={[
              'flex items-start justify-between py-4',
              entry.data.url && 'group hover:bg-ink/[0.02] -mx-2 px-2 rounded transition-colors'
            ]}
          >
            <div>
              <div class="flex items-center gap-2">
                <h3 class:list={['text-sm font-bold text-ink', entry.data.url && 'group-hover:text-accent-blue transition-colors']}>
                  {entry.data.title}
                </h3>
                {entry.data.url && (
                  <svg class="w-3 h-3 text-ink/35 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                )}
              </div>
              {entry.data.description && (
                <p class="text-xs text-ink/50 mt-1">{entry.data.description}</p>
              )}
            </div>
            {entry.data.tags && entry.data.tags.length > 0 && (
              <div class="flex gap-1.5 shrink-0 ml-3">
                {entry.data.tags.map((tag: string) => (
                  <span class="text-[10px] text-ink/40 bg-ink/[0.04] px-1.5 py-0.5 rounded-full">{tag}</span>
                ))}
              </div>
            )}
          </Tag>
        );
      })}
    </div>

    {sortedEntries.length === 0 && (
      <p class="text-center text-ink/40 py-12">곧 함께하는 팀들을 소개합니다.</p>
    )}
  </section>
</BaseLayout>
