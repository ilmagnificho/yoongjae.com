---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.isDraft)
    .map((post) => ({
      params: { id: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="py-8">
    <header class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <time class="text-sm text-ink/40 font-mono" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <div class="flex gap-1.5">
          {post.data.tags.map((tag: string) => (
            <span class="text-xs text-ink/40 bg-ink/[0.04] px-2 py-0.5 rounded-full">{tag}</span>
          ))}
        </div>
      </div>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight">{post.data.title}</h1>
      {post.data.description && (
        <p class="text-lg text-ink/50 mt-4">{post.data.description}</p>
      )}
    </header>

    <div class="prose text-ink/80 text-base leading-relaxed">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t border-ink/10">
      <a href="/writing" class="text-sm text-ink/40 hover:text-ink transition-colors">
        &larr; Back to Writing
      </a>
    </footer>
  </article>
</BaseLayout>
