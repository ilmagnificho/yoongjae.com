---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.isDraft)
    .map((post) => ({
      params: { id: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const postUrl = `/blog/${post.id}`;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="py-4">
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <time class="text-xs text-ink/40 font-mono" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <div class="flex gap-1.5">
          {post.data.tags.map((tag: string) => (
            <span class="text-[10px] text-ink/40 bg-ink/[0.04] px-1.5 py-0.5 rounded-full">{tag}</span>
          ))}
        </div>
      </div>
      <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight">{post.data.title}</h1>
      {post.data.description && (
        <p class="text-base text-ink/50 mt-3">{post.data.description}</p>
      )}
    </header>

    <div class="prose text-ink/80 text-sm leading-relaxed">
      <Content />
    </div>

    <ShareButtons title={post.data.title} url={postUrl} />

    <footer class="mt-10 pt-6 border-t border-ink/10">
      <a href="/writing" class="text-xs text-ink/40 hover:text-ink transition-colors">
        &larr; 글 목록으로
      </a>
    </footer>
  </article>
</BaseLayout>
