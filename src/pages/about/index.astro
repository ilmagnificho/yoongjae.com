---
import BaseLayout from '../../layouts/BaseLayout.astro';

const timeline = [
  { year: '2024 - Present', role: 'CEO', org: 'Tetra Corp', url: 'https://www.tetracorp.co.kr/', description: 'Startup studio creating, investing in, and growing early-stage ventures with a team of legal, PR, and VC experts.' },
  { year: '2024 - Present', role: 'GP', org: '조약돌개인투자조합', description: 'General Partner of a private investment fund focused on early-stage startup investments.' },
  { year: '2020 - 2023', role: 'New Business Team Lead', org: 'KRAFTON Inc.', description: 'Corporate development and new business initiatives at the global gaming company (parent of PUBG).' },
  { year: '2021 - 2022', role: 'COO', org: 'thingsflow', description: 'Mobile app startup acquired by KRAFTON in 2021. Led operations as a KRAFTON subsidiary.', nested: true },
  { year: '2018 - 2023', role: 'CEO Staff', org: 'PUBG Corporation', description: 'Corporate development at the publisher of PLAYERUNKNOWN\'S BATTLEGROUNDS. PUBG was a KRAFTON subsidiary, later merged.' },
  { year: '2014 - 2016', role: 'Investment Associate', org: 'BonAngels Venture Partners', description: 'One of the earliest and leading early-stage VC firms in Korea.' },
  { year: '2010 - 2014', role: 'Analyst → Assistant Manager', org: 'ORIX Corporation (Tokyo, HQ)', description: 'Private equity and financial services. Started at ORIX PE Korea, then transferred to ORIX Corporation headquarters in Tokyo.' },
];
---

<BaseLayout title="About" description="About YoongJae - CEO of Tetra Corp, startup studio builder and investor.">
  <section class="py-4">
    <h1 class="font-serif text-3xl font-bold mb-5">About</h1>

    <div class="space-y-4 text-ink/70 text-sm leading-relaxed mb-10">
      <p>
        I'm the CEO of <a href="https://www.tetracorp.co.kr/" target="_blank" rel="noopener noreferrer" class="text-ink font-semibold hover:text-accent-blue transition-colors">Tetra Corporation</a>,
        a startup studio in Seoul. Together with co-founders from legal, PR, and VC backgrounds,
        we create, invest in, and grow early-stage ventures.
      </p>
      <p>
        I also serve as the General Partner of <strong class="text-ink">조약돌개인투자조합</strong>,
        a private investment fund focused on early-stage startups.
      </p>
      <p>
        My background spans venture capital, corporate development, and startup operations &mdash;
        from early-stage investing at BonAngels to M&A and new business at KRAFTON/PUBG,
        and private equity at ORIX in Tokyo.
      </p>
      <p>
        This site is my digital home &mdash; a place to share essays and investment insights
        with the Korean tech ecosystem.
      </p>
    </div>

    <!-- Career Timeline -->
    <h2 class="font-serif text-xl font-semibold mb-5">Timeline</h2>
    <div class="space-y-5 mb-10">
      {timeline.map((item) => (
        <div class:list={['flex gap-3 md:gap-4', item.nested && 'ml-4 md:ml-5 border-l-2 border-ink/10 pl-3 md:pl-4']}>
          <div class="w-24 md:w-32 shrink-0">
            <span class="text-[11px] md:text-xs text-ink/40 font-mono">{item.year}</span>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-ink">
              {item.role} <span class="text-ink/40 font-normal">@ {
                item.url
                  ? <a href={item.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent-blue transition-colors">{item.org}</a>
                  : item.org
              }</span>
            </h3>
            <p class="text-xs text-ink/50 mt-0.5">{item.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Contact -->
    <h2 class="font-serif text-xl font-semibold mb-3">Contact</h2>
    <p class="text-sm text-ink/60">
      Reach me via
      <a href="https://www.linkedin.com/in/yjcho/" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:underline">LinkedIn</a>
      or
      <a href="https://www.threads.com/@ilmagnificho" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:underline">Threads</a>.
    </p>
  </section>
</BaseLayout>
