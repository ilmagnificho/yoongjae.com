---
import BaseLayout from '../../layouts/BaseLayout.astro';

const timeline = [
  { year: '2024 - Present', role: 'CEO', org: 'Tetra Corp', description: 'Boutique startup consultancy & investment. Founded by legal, PR, and VC experts in Seoul.' },
  { year: '2020 - 2023', role: 'New Business Team Lead', org: 'KRAFTON Inc.', description: 'Corporate development and new business initiatives at the global gaming company (parent of PUBG).' },
  { year: '2021 - 2022', role: 'COO', org: 'thingsflow', description: 'Mobile app startup acquired by KRAFTON in 2021. Led operations as a KRAFTON subsidiary.', nested: true },
  { year: '2018 - 2023', role: 'CEO Staff', org: 'PUBG Corporation', description: 'Corporate development at the publisher of PLAYERUNKNOWN\'S BATTLEGROUNDS. PUBG was a KRAFTON subsidiary, later merged.' },
  { year: '2014 - 2016', role: 'Investment Associate', org: 'BonAngels Venture Partners', description: 'One of the earliest and leading early-stage VC firms in Korea.' },
  { year: '2010 - 2014', role: 'Analyst → Assistant Manager', org: 'ORIX Corporation', description: 'Private equity and financial services. Started at ORIX PE Korea, then ORIX Japan (Tokyo).' },
];
---

<BaseLayout title="About" description="About YoongJae - CEO of Tetra Corp, investor and startup advisor.">
  <section class="py-8">
    <h1 class="font-serif text-4xl font-bold mb-8">About</h1>

    <div class="space-y-6 text-ink/70 text-base leading-relaxed mb-16">
      <p>
        I'm the CEO of <strong class="text-ink">Tetra Corporation</strong>, a boutique startup consultancy
        in Seoul founded by legal, PR, and VC experts. We provide hands-on solutions for startups
        with resource challenges, and actively explore investment opportunities.
      </p>
      <p>
        My background spans venture capital, corporate development, and startup operations &mdash;
        from early-stage investing at BonAngels to M&A and new business at KRAFTON/PUBG,
        and private equity at ORIX in Tokyo.
      </p>
      <p>
        This site is my digital home &mdash; a place to share essays and investment insights
        with the Korean tech ecosystem.
      </p>
    </div>

    <!-- Career Timeline -->
    <h2 class="font-serif text-2xl font-semibold mb-8">Timeline</h2>
    <div class="space-y-8 mb-16">
      {timeline.map((item) => (
        <div class:list={['flex gap-6', item.nested && 'ml-6 border-l-2 border-ink/10 pl-6']}>
          <div class="w-36 shrink-0">
            <span class="text-sm text-ink/40 font-mono">{item.year}</span>
          </div>
          <div>
            <h3 class="font-semibold text-ink">
              {item.role} <span class="text-ink/40 font-normal">@ {item.org}</span>
            </h3>
            <p class="text-sm text-ink/50 mt-1">{item.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Contact -->
    <h2 class="font-serif text-2xl font-semibold mb-4">Contact</h2>
    <p class="text-ink/60">
      Reach me via
      <a href="https://www.linkedin.com/in/yjcho/" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:underline">LinkedIn</a>
      or
      <a href="https://www.threads.com/@ilmagnificho" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:underline">Threads</a>.
    </p>
  </section>
</BaseLayout>
