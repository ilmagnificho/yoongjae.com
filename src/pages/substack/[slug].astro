---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  // Only generate pages for free Substack posts (they have content and slug)
  return posts
    .filter((post) => post.content && post.slug && !post.isPaid)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.description}>
  <article class="py-8">
    <header class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <time class="text-sm text-ink/40 font-mono" datetime={post.date.toISOString()}>
          {formatDate(post.date)}
        </time>
        <div class="flex gap-1.5">
          {post.tags.map((tag: string) => (
            <span class="text-xs text-ink/40 bg-ink/[0.04] px-2 py-0.5 rounded-full">{tag}</span>
          ))}
        </div>
        <span class="text-xs text-accent-orange bg-accent-orange/10 px-2 py-0.5 rounded-full">
          Substack
        </span>
      </div>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight">{post.title}</h1>
      {post.description && (
        <p class="text-lg text-ink/50 mt-4">{post.description}</p>
      )}
    </header>

    <div class="prose text-ink/80 text-base leading-relaxed" set:html={post.content} />

    <footer class="mt-16 pt-8 border-t border-ink/10 flex items-center justify-between">
      <a href="/writing" class="text-sm text-ink/40 hover:text-ink transition-colors">
        &larr; Back to Writing
      </a>
      {post.substackUrl && (
        <a
          href={post.substackUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-accent-orange hover:text-accent-orange/80 transition-colors"
        >
          View on Substack
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
        </a>
      )}
    </footer>
  </article>
</BaseLayout>
