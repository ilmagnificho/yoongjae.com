---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const portfolioEntries = await getCollection('portfolio');
const sortedEntries = portfolioEntries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Portfolio" description="Investment portfolio.">
  <section class="py-8">
    <h1 class="font-serif text-4xl font-bold mb-4">Portfolio</h1>
    <p class="text-ink/50 mb-12">Investment portfolio via Tetra Corp.</p>

    <h2 class="font-serif text-2xl font-semibold mb-8">Investments</h2>
    <div class="space-y-4">
      {sortedEntries.map((entry) => (
        <div class="flex items-center justify-between py-4 border-b border-ink/5">
          <div class="flex items-center gap-3">
            <h3 class="font-semibold text-ink">{entry.data.title}</h3>
            {entry.data.tags.map((tag: string) => (
              <span class="text-xs text-ink/30 bg-ink/[0.03] px-2 py-0.5 rounded-full">{tag}</span>
            ))}
          </div>
          <span class="text-sm text-ink/40 font-mono shrink-0">2025 - Present</span>
        </div>
      ))}
    </div>

    {sortedEntries.length === 0 && (
      <p class="text-center text-ink/40 py-12">Portfolio items coming soon.</p>
    )}
  </section>
</BaseLayout>
