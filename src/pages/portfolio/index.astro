---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = Astro.site?.toString() ?? 'https://yoongjae.com';

const portfolioEntries = await getCollection('portfolio');
const sortedEntries = portfolioEntries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Portfolio Investments',
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: sortedEntries.length,
  itemListElement: sortedEntries.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: entry.data.url ?? new URL(`/portfolio#${entry.id}`, siteUrl).toString(),
    name: entry.data.title,
    description: entry.data.description,
  })),
};
---

<BaseLayout title="포트폴리오 Portfolio" description="한국 창업자 생태계와 함께 만든 조약돌개인투자조합 투자 포트폴리오." canonicalUrl="/portfolio">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <section class="py-4">
    <h1 class="font-serif text-3xl font-bold mb-2">포트폴리오 Portfolio</h1>
    <p class="text-sm text-ink/55 mb-6">한국 창업자에게 필요한 문제 해결력과 실행력을 기준으로 함께한 팀들을 소개합니다.</p>

    <h2 class="font-serif text-xl font-semibold mb-4">주요 투자사 Investments</h2>
    <div class="space-y-0 divide-y divide-ink/8">
      {sortedEntries.map((entry) => {
        const Tag = entry.data.url ? 'a' : 'div';
        const linkProps = entry.data.url
          ? { href: entry.data.url, target: '_blank', rel: 'noopener noreferrer' }
          : {};
        return (
          <Tag
            {...linkProps}
            class:list={[
              'flex items-center justify-between py-3',
              entry.data.url && 'group hover:bg-ink/[0.02] -mx-2 px-2 rounded transition-colors'
            ]}
          >
            <div class="flex items-center gap-2">
              <h3 class:list={['text-sm font-semibold text-ink', entry.data.url && 'group-hover:text-accent-blue transition-colors']}>
                {entry.data.title}
              </h3>
              {entry.data.url && (
                <svg class="w-3 h-3 text-ink/35 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              )}
            </div>
            <span class="text-xs text-ink/50 font-mono shrink-0">2025 - Present</span>
          </Tag>
        );
      })}
    </div>

    {sortedEntries.length === 0 && (
      <p class="text-center text-ink/40 py-12">곧 더 많은 포트폴리오를 업데이트합니다.</p>
    )}
  </section>
</BaseLayout>
