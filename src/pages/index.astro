---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getSortedPosts } from '../lib/posts';

const allPosts = await getSortedPosts();
const recentPosts = allPosts.slice(0, 5);
---

<BaseLayout>
  <!-- Hero -->
  <section class="pt-10 pb-10 md:pt-14 md:pb-12">
    <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight mb-3">
      한국 창업자와 투자자를 위한<br />
      <span class="text-ink/45">실전 인사이트 아카이브</span><br />
      <span class="text-xl md:text-2xl text-ink/40">Investor &amp; Builder Notes</span>
    </h1>
    <p class="text-base text-ink/65 max-w-xl">
      <a href="https://www.tetracorp.co.kr/" target="_blank" rel="noopener noreferrer" class="hover:text-accent-blue transition-colors">테트라</a> 대표,
      조약돌개인투자조합 GP로서 초기 스타트업의 설립·성장·투자를 함께합니다.<br />
      국내 생태계에 필요한 테크·자본·실행 관점을 정리합니다.
    </p>
  </section>

  <!-- 최근 글 Writing -->
  <section class="pb-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-serif text-xl font-semibold">최근 글 Writing</h2>
      <a href="/writing" class="text-sm text-ink/50 hover:text-ink transition-colors">
        전체 글 보기 &rarr;
      </a>
    </div>
    <PostList posts={recentPosts} />
  </section>

  <!-- Tools -->
  <section class="pb-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-serif text-xl font-semibold">무료 스타트업 도구</h2>
      <a href="/tools" class="text-sm text-ink/50 hover:text-ink transition-colors">
        전체 도구 보기 &rarr;
      </a>
    </div>
    <p class="text-sm text-ink/45 mb-4">VC와 창업자의 시각으로 만든 실용 계산 도구</p>
    <a
      href="/tools/cap-table"
      class="group block border border-ink/10 rounded-lg p-4 hover:border-ink/20 hover:bg-ink/[0.02] transition-all"
    >
      <h3 class="font-serif text-base font-semibold group-hover:text-accent-blue transition-colors">
        Cap Table 계산기
      </h3>
      <p class="text-sm text-ink/50 mt-1">투자 라운드별 지분 희석을 시뮬레이션하세요</p>
      <span class="text-sm text-accent-blue mt-2 inline-block group-hover:translate-x-0.5 transition-transform">
        사용하기 &rarr;
      </span>
    </a>
  </section>
</BaseLayout>
