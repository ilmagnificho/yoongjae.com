---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getSortedPosts } from '../lib/posts';

const allPosts = await getSortedPosts();
const recentPosts = allPosts.slice(0, 5);
---

<BaseLayout>
  <!-- Hero -->
  <section class="py-16 md:py-24">
    <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight mb-6">
      Investor. Advisor.<br />
      <span class="text-ink/50">Curating insights on<br />Tech & Capital.</span>
    </h1>
    <p class="text-lg text-ink/60 max-w-xl">
      CEO at <a href="https://www.tetracorp.co.kr/" target="_blank" rel="noopener noreferrer" class="hover:text-accent-blue transition-colors">Tetra Corp</a>. GP at 조약돌개인투자조합.<br />
      Startup studio &amp; early-stage investments.
    </p>
  </section>

  <!-- Recent Writings -->
  <section class="pb-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="font-serif text-2xl font-semibold">Recent Writings</h2>
      <a href="/writing" class="text-sm text-ink/40 hover:text-ink transition-colors">
        View all &rarr;
      </a>
    </div>
    <PostList posts={recentPosts} />
  </section>
</BaseLayout>
