---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getSortedPosts } from '../lib/posts';

const allPosts = await getSortedPosts();
const recentPosts = allPosts.slice(0, 5);

const portfolioEntries = await getCollection('portfolio');
const sortedPortfolio = portfolioEntries
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<BaseLayout>
  <!-- Hero -->
  <section class="pt-12 pb-8 md:pt-16 md:pb-10 border-b border-ink/8">
    <p class="text-xs text-ink/40 font-mono tracking-wider uppercase mb-4">Investor &amp; Builder</p>
    <h1 class="font-serif text-4xl md:text-5xl font-bold leading-[1.15] mb-5">
      한국 창업자와 함께<br />
      만들고, 투자합니다.
    </h1>
    <p class="text-base text-ink/60 max-w-lg leading-relaxed">
      <a href="https://www.tetracorp.co.kr/" target="_blank" rel="noopener noreferrer" class="text-ink/80 hover:text-accent-blue transition-colors font-bold">테트라</a> 대표 · 조약돌개인투자조합 GP.<br />
      초기 스타트업의 설립·성장·투자를 함께하며,<br class="hidden md:inline" />
      한국 생태계에 필요한 실전 관점을 기록합니다.
    </p>
    <div class="flex gap-4 mt-6">
      <a href="/writing" class="inline-flex items-center gap-1.5 text-sm font-bold text-accent-blue hover:text-accent-blue/80 transition-colors">
        글 읽기
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="/about" class="inline-flex items-center gap-1.5 text-sm font-bold text-ink/45 hover:text-ink transition-colors">
        소개 보기
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <!-- 최근 글 Writing -->
  <section class="py-8 border-b border-ink/8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-serif text-xl font-semibold">최근 글</h2>
      <a href="/writing" class="text-xs text-ink/40 hover:text-ink font-mono transition-colors">
        전체 보기 &rarr;
      </a>
    </div>
    <PostList posts={recentPosts} />
  </section>

  <!-- Portfolio Preview -->
  {sortedPortfolio.length > 0 && (
    <section class="py-8 border-b border-ink/8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-serif text-xl font-semibold">함께하는 팀</h2>
        <a href="/companies" class="text-xs text-ink/40 hover:text-ink font-mono transition-colors">
          전체 보기 &rarr;
        </a>
      </div>
      <div class="flex flex-wrap gap-2">
        {sortedPortfolio.map((entry) => {
          const Tag = entry.data.url ? 'a' : 'span';
          const linkProps = entry.data.url
            ? { href: entry.data.url, target: '_blank', rel: 'noopener noreferrer' }
            : {};
          return (
            <Tag
              {...linkProps}
              class:list={[
                'text-sm font-semibold px-3 py-1.5 border border-ink/10 rounded-lg',
                entry.data.url
                  ? 'hover:border-accent-blue hover:text-accent-blue transition-colors'
                  : 'text-ink/70',
              ]}
            >
              {entry.data.title}
            </Tag>
          );
        })}
      </div>
    </section>
  )}

  <!-- Tools -->
  <section class="py-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-serif text-xl font-semibold">무료 도구</h2>
      <a href="/tools" class="text-xs text-ink/40 hover:text-ink font-mono transition-colors">
        전체 보기 &rarr;
      </a>
    </div>
    <div class="space-y-2">
      {[
        { href: '/tools/prompt', name: 'PromptForge', desc: 'Claude & Gemini 프롬프트 생성기' },
        { href: '/tools/cap-table', name: 'Cap Table 계산기', desc: '투자 라운드별 지분 희석 시뮬레이션' },
        { href: '/tools/safe-simulator', name: 'SAFE 시뮬레이터', desc: 'Valuation Cap · Discount 전환가격 비교' },
        { href: '/tools/esop-calculator', name: 'ESOP 계산기', desc: 'Exit 시나리오별 스톡옵션 수익 계산' },
      ].map((tool) => (
        <a
          href={tool.href}
          class="group flex items-center justify-between border border-ink/10 rounded-lg p-3 hover:border-ink/20 hover:bg-ink/[0.02] transition-all"
        >
          <div>
            <h3 class="text-sm font-bold group-hover:text-accent-blue transition-colors">{tool.name}</h3>
            <p class="text-xs text-ink/45 mt-0.5">{tool.desc}</p>
          </div>
          <span class="text-accent-blue text-sm group-hover:translate-x-0.5 transition-transform shrink-0 ml-3">&rarr;</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
