---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, getLangAlternates } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articleDate?: Date;
  articleTags?: string[];
  hideFooter?: boolean;
}

const {
  title = 'YoongJae',
  description = 'CEO at 테트라. GP at 조약돌개인투자조합. Startup studio & early-stage investments.',
  canonicalUrl,
  ogImage,
  ogType = 'website',
  articleDate,
  articleTags,
  hideFooter = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const ogLocale = lang === 'en' ? 'en_US' : 'ko_KR';

const pageTitle = title === 'YoongJae' ? title : `${title} | YoongJae`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://yoongjae.com';
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).toString() : new URL('/og/home.png', siteUrl).toString();
const canonicalHref = canonicalUrl
  ? new URL(canonicalUrl, siteUrl).toString()
  : Astro.url.toString();

const alternates = getLangAlternates(Astro.url, siteUrl);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'YoongJae Cho',
  jobTitle: 'CEO',
  worksFor: {
    '@type': 'Organization',
    name: 'Tetra Corp',
    url: 'https://www.tetracorp.co.kr/',
  },
  url: siteUrl,
  sameAs: [
    'https://www.linkedin.com/in/yjcho/',
    'https://www.threads.com/@ilmagnificho',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    {alternates && <link rel="alternate" hreflang="ko" href={alternates.ko} />}
    {alternates && <link rel="alternate" hreflang="en" href={alternates.en} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={alternates.ko} />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="YoongJae" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    {articleDate && <meta property="article:author" content="YoongJae Cho" />}
    {articleTags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <slot name="head" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MPY1QKT15E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MPY1QKT15E');
    </script>
    <!-- Google AdSense -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2021805347195633" crossorigin="anonymous"></script>
<script is:inline>
      if (localStorage.getItem('skip_analytics') !== 'true') {
        const script = document.createElement('script');
        script.src = "https://static.cloudflareinsights.com/beacon.min.js";
        script.setAttribute("data-cf-beacon", '{"token": "6eafbb9814ab488baf067bb73405c041"}');
        script.defer = true;
        document.head.appendChild(script);
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-3xl mx-auto px-6 py-6">
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
