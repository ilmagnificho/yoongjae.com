---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = 'YoongJae',
  description = 'CEO at 테트라. GP at 조약돌개인투자조합. Startup studio & early-stage investments.',
  canonicalUrl,
  ogImage,
} = Astro.props;

const pageTitle = title === 'YoongJae' ? title : `${title} | YoongJae`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://yoongjae.com';
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).toString() : new URL('/og/home.png', siteUrl).toString();
const canonicalHref = canonicalUrl
  ? new URL(canonicalUrl, siteUrl).toString()
  : Astro.url.toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'YoongJae Cho',
  jobTitle: 'CEO',
  worksFor: {
    '@type': 'Organization',
    name: 'Tetra Corp',
    url: 'https://www.tetracorp.co.kr/',
  },
  url: siteUrl,
  sameAs: [
    'https://www.linkedin.com/in/yjcho/',
    'https://www.threads.com/@ilmagnificho',
  ],
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <slot name="head" />
<script is:inline>
      if (localStorage.getItem('skip_analytics') !== 'true') {
        const script = document.createElement('script');
        script.src = "https://static.cloudflareinsights.com/beacon.min.js";
        script.setAttribute("data-cf-beacon", '{"token": "6eafbb9814ab488baf067bb73405c041"}');
        script.defer = true;
        document.head.appendChild(script);
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-3xl mx-auto px-6 py-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
